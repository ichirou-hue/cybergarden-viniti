# Copy to .env locally if desired. The project loads the local .env automatically.
# Never commit or share the real key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.wikivibe.dev/v1
OPENAI_MODEL=gpt-5.6-luna
# Network access stays off until you explicitly change this to api.
VINITI_PARSE_LLM=off
# API requests may take longer for large PDFs.
OPENAI_LLM_TIMEOUT=600
OPENAI_LLM_RETRIES=1
