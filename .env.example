# Copy to .env locally if desired. The project loads the local .env automatically.
# Never commit or share the real key.
OPENROUTER_API_KEY=
# Exact model slug from your OpenRouter account. No model is selected by default.
OPENROUTER_MODEL=
# Vision-capable model slug for automatic page reading (columns and LaTeX).
OPENROUTER_VISION_MODEL=

# Generic chat-completions endpoint for the profile LLM shell (`--llm-shell api`).
# OPENAI_API_KEY and OPENAI_MODEL win over the OPENROUTER_* fallback above.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Network access stays off until you explicitly change this to api.
VINITI_PARSE_LLM=off
# API requests may take longer for large PDFs.
OPENAI_LLM_TIMEOUT=600
OPENAI_LLM_RETRIES=1
